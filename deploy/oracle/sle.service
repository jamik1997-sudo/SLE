[Unit]
Description=SLE FastAPI Backend
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/SLE/backend
EnvironmentFile=/home/ubuntu/SLE/backend/.env
ExecStartPre=/home/ubuntu/SLE/backend/venv/bin/python /home/ubuntu/SLE/backend/run_migrations.py
ExecStart=/home/ubuntu/SLE/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
